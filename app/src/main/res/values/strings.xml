    <string name="about_what_title">What the app does</string>
    <string name="about_what_body">BabakCast downloads videos from YouTube, X (Twitter), Instagram and LinkedIn, and lets you share them. It can also copy or share a tweet\'s text, and summarize a YouTube video\'s transcript (the written text of what is said) using an AI provider you set up yourself.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_no_tracking">BabakCast has no accounts, no ads, and no tracking or analytics.</string>
    <string name="about_privacy_no_server">The developer runs no server and receives none of your data.</string>
    <string name="about_privacy_direct">BabakCast needs the internet. To download a video, it contacts the site the link belongs to. To summarize or translate, it sends the text to the AI provider you chose in Settings.</string>
    <string name="about_privacy_keys">An API key is the access code your AI provider gives you. Your keys stay encrypted on your phone, and each key is sent only to its own provider.</string>
    <string name="about_privacy_local">Downloads and settings stay on your phone and are removed when you uninstall the app.</string>
    <string name="about_privacy_link">Read the privacy policy</string>
    <string name="about_links_title">Links</string>
    <string name="about_website">Open the website</string>
    <string name="about_source">See the source code on GitHub</string>
    <string name="about_report">Report a problem on GitHub</string>
    <string name="about_credits">Credits and licenses</string>
    <string name="about_license">BabakCast is free software, released under the Apache License 2.0.</string>
    <string name="about_credits_body">Built with Kotlin, Jetpack Compose and Hilt. Downloads and transcripts rely on youtubedl-android, and splitting video and audio relies on FFmpegKit.</string>
    <string name="about_made_by_title">Made by Cocode</string>
    <string name="about_created_by">Created by Babak Bandpey.</string>
    <string name="about_made_by">Made by Cocode (cocode.dk)</string>
