<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup and device transfer rules for Android 12 and newer.
     Everything is included except the two small files that record which yt-dlp is installed
     (and when it was last refreshed). yt-dlp itself lives in a folder that is not backed up
     or transferred, so after a restore these records would describe a file that is not there.
     See https://developer.android.com/about/versions/12/backup-restore#xml-changes -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="youtubedl-android.xml"/>
        <exclude domain="sharedpref" path="ytdlp_update.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="youtubedl-android.xml"/>
        <exclude domain="sharedpref" path="ytdlp_update.xml"/>
    </device-transfer>
</data-extraction-rules>
