<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup rules for Android 11 and older.
     Everything is backed up except the two small files that record which yt-dlp is installed
     (and when it was last refreshed). yt-dlp itself lives in a folder that is not backed up,
     so after a restore these records would describe a file that is not there.
     See https://developer.android.com/guide/topics/data/autobackup -->
<full-backup-content>
    <exclude domain="sharedpref" path="youtubedl-android.xml"/>
    <exclude domain="sharedpref" path="ytdlp_update.xml"/>
</full-backup-content>
